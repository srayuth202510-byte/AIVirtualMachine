{
  "name": "local-coder",
  "replicas": 1,
  "binary": "/absolute/path/to/aivm",
  "binary_sha256": "REPLACE_WITH_SHA256_OF_BINARY",
  "vm_config": {
    "name": "template",
    "runtime": {
      "isolation": "container",
      "container": {
        "bubblewrap": "/usr/bin/bwrap",
        "init": "/usr/libexec/aivm-container-init"
      }
    },
    "model": {"provider": "echo", "name": "echo"},
    "capabilities": {"initial": ["read:workspace", "search:code"]},
    "network": {"allow": []}
  },
  "task": "Inspect the fresh workspace and report what you find.",
  "max_steps": 8,
  "max_replacements": 2,
  "window_seconds": 3600,
  "job_timeout_seconds": 300
}
